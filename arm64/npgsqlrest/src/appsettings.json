{
  "ApplicationName": "npgsqlrest",
  "EnvironmentName": "Production",
  "Urls": "http://127.0.0.1:8080",
  "ConnectionStrings": {
    "Default": "Host={!PGHOST:localhost};Port={!PGPORT:5432};Database={!PGDATABASE};Username={!PGUSER:postgres};Password={!PGPASSWORD}"
  },
  "NpgsqlRest": {
    "UrlPathPrefix": "/api",
    "RequiresAuthorization": true,
    "KebabCaseUrls": true,
    "CamelCaseNames": true
  },
  "Log": {
    "MinimalLevels": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
