# PostgREST default configuration
# Environment variables for PostgREST

# Database connection string
# Set this before exposing the service.
# PGRST_DB_URI="postgres://authenticator:change-me@localhost:5432/dbname"

# Schema to expose
# PGRST_DB_SCHEMAS="public"

# Anonymous role
# Leave unset to block anonymous requests; set only after granting that role.
# PGRST_DB_ANON_ROLE="anon"

# Server host and port
# PGRST_SERVER_HOST="127.0.0.1"
# PGRST_SERVER_PORT="3000"
