# NpgsqlRest default configuration
# Environment variables for NpgsqlRest
# Use double-underscore (__) for hierarchy levels

# Database connection string
# Set PGDATABASE and PGPASSWORD before starting the service. PGHOST, PGPORT,
# and PGUSER use the fallbacks declared in appsettings.json.
# PGDATABASE="mydb"
# PGPASSWORD="change-me"

# Server URLs (packaged default: http://127.0.0.1:8080)
# Urls="http://127.0.0.1:8080"

# API configuration
# NpgsqlRest__UrlPathPrefix="/api"
# Authorization is required by default; configure an authentication scheme.
# NpgsqlRest__RequiresAuthorization="true"

# Application settings
# ApplicationName="npgsqlrest"
# EnvironmentName="Production"
